{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"tests/**/*.test.ts\"",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-check.mts",
    "db:init": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-init.mts",
    "db:legacy-ownership": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-legacy-ownership.mts",
    "r2:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/r2-check.mts",
    "email:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/email-worker.mts",
    "sandbox:snapshot": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/sandbox-snapshot.mts",
    "sandbox:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/sandbox-smoke.mts",
    "sandbox:measure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/sandbox-measure.mts",
    "email:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/email-test.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@vercel/oidc": "4.0.0",
    "@vercel/sandbox": "3.9.1",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "engines": {
    "node": "24.x"
  }
