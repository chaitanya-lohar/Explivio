# Copy to web/.env.local (gitignored) and fill in. Placeholders only: never commit real values.
# The pipeline's own keys (Gemini, ElevenLabs) stay in the repo-root .env, not here.

# "pipeline" (default) runs the real video pipeline in the repo root; "mock" uses in-memory sample data (no API keys or rendering).
VIDEO_SERVICE=pipeline

# Folder that contains the pipeline (src/cli.ts, runs/). Defaults to the parent of web/.
# EXPLIVIO_PIPELINE_ROOT=..

# MongoDB Atlas (secret, server-only; never use a NEXT_PUBLIC_ name). From Atlas: Connect > Drivers > connection string,
# with your database user's password filled in. Check it with: npm run db:check
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=explivio
# Database name inside the cluster (letters, numbers, - and _).
MONGODB_DB=explivio

# Email of the account that should own the videos made before accounts existed (used only by db:legacy-ownership).
# EXPLIVIO_LEGACY_OWNER_EMAIL=you@example.com
