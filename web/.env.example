# Copy to web/.env.local (gitignored) and fill in. Placeholders only: never commit real values.
# The pipeline's own keys (Gemini, ElevenLabs) stay in the repo-root .env, not here.

# "pipeline" (default) runs the real video pipeline in the repo root; "mock" uses in-memory sample data (no API keys or rendering).
VIDEO_SERVICE=pipeline

# Folder that contains the pipeline (src/cli.ts, runs/). Defaults to the parent of web/.
# EXPLIVIO_PIPELINE_ROOT=..

# MongoDB Atlas (secret, server-only; never use a NEXT_PUBLIC_ name). From Atlas: Connect > Drivers > connection string,
# with your database user's password filled in. Check it with: npm run db:check
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=explivio
# Database name inside the cluster (letters, numbers, - and _).
MONGODB_DB=explivio

# Email of the account that should own the videos made before accounts existed (used only by db:legacy-ownership).
# EXPLIVIO_LEGACY_OWNER_EMAIL=you@example.com

# Cloudflare R2 video storage (F11; optional, secret, server-only). With these unset, new videos stay in runs/ only.
# Create a private bucket (Standard storage, no jurisdiction) and an "Object Read & Write" token limited to it.
# Check it with: npm run r2:check
# R2_ACCOUNT_ID=<32-character account id from the R2 overview page>
# R2_ACCESS_KEY_ID=<access key id shown once when the token is created>
# R2_SECRET_ACCESS_KEY=<secret access key shown once when the token is created>
# R2_BUCKET_NAME=explivio-assets
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Email (F13). Unset or "outbox": messages are saved to data/outbox (nothing is sent). "resend": real email through
# Resend (free plan: 100/day, 3,000/month). Without a verified domain of your own, Resend only delivers to the address
# your Resend account uses. Links in emails use EXPLIVIO_APP_URL (never the request host).
# EMAIL_TRANSPORT=outbox
# RESEND_API_KEY=re_<sending-access key from resend.com/api-keys>
# EMAIL_FROM=Explivio <onboarding@resend.dev>
# EXPLIVIO_APP_URL=http://localhost:3000
# Daily cap on emails across the app (UTC day), kept below the provider limit. Default 90.
# EXPLIVIO_EMAIL_DAILY_LIMIT=90
# "off" stops the in-server email worker (then run: npm run email:worker).
# EXPLIVIO_EMAIL_WORKER=on
