# Copy this file to .env, then add your own credentials and voice IDs.
GEMINI_API_KEY=
# gemini-3.8-flash was unresponsive in testing (2026-11-01); 3.6 answers in about 2s.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Per-request timeout, and how long to skip a model after it hangs or is overloaded.
GEMINI_TIMEOUT_MS=45000
GEMINI_SKIP_FAILED_MODEL_MINUTES=30
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_GENDER=default
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: overrides the narrator for `npm run render:api` (e.g. an Indian-English library voice; needs a paid plan).
ELEVENLABS_NARRATOR_VOICE_ID=
